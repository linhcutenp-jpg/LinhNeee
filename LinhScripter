local function cleanupAll()
    for plr, _ in pairs(espData) do removeESP(plr) end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then pcall(function() obj.LocalTransparencyModifier = 0 end) end
    end
    if bv then pcall(function() bv:Destroy() end); bv = nil end
    if flyConn and flyConn.Connected then pcall(function() flyConn:Disconnect() end) end
    if noclipConn and noclipConn.Connected then pcall(function() noclipConn:Disconnect() end) end
    if distanceCheckConn and distanceCheckConn.Connected then pcall(function() distanceCheckConn:Disconnect() end) end
    for _, c in ipairs(allConns) do if c and c.Connected then pcall(function() c:Disconnect() end) end end
    pcall(function() CAS:UnbindAction("ToggleMenu_RShift") end)
    if lp and lp.Character then
        local humanoid = lp.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function() humanoid.WalkSpeed = 16 end)
            pcall(function() humanoid.JumpPower = 50 end)
            pcall(function() humanoid.PlatformStand = false end)
        end
        for _, part in pairs(lp.Character:GetDescendants()) do
            if part:IsA("BasePart") then pcall(function() part.CanCollide = true end) end
        end
    end
    if screen and screen.Parent then pcall(function() screen:Destroy() end) end
end

