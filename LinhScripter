local function setAlphaFromX(x)
    local barPos, barSize = bar.AbsolutePosition.X, bar.AbsoluteSize.X
    if barSize == 0 then return end
    local rel = math.clamp((x - barPos) / barSize, 0, 1)
    knob.Position = UDim2.new(rel, -7, 0.5, -7)
    win.BackgroundTransparency = rel * 0.6
    header.BackgroundTransparency = math.clamp(rel * 0.6 - 0.1, 0, 1)
    stroke.Thickness = 2 * (1 - rel * 0.6) + 0.5
end
