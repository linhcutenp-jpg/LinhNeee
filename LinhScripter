        for _, btn in pairs(keyButtons) do
            if btn.BackgroundColor3 == Color3.fromRGB(130,130,80) then
                btn.BackgroundColor3 = Color3.fromRGB(70,70,80)
            end
        end
    end
end

-- Lưu key mới
local function saveKey(action, keyName)
    userKeybinds[action] = keyName
    if keyButtons[action] then
        keyButtons[action].Text = keyName
        keyButtons[action].BackgroundColor3 = Color3.fromRGB(70,70,80)
    end
end

-- Tạo nút đổi key (có thể click)
local function makeKeyButton(tabIndex, labelText, action)
    local row, lbl = TabRow(tabIndex, labelText)
    local btn = C("TextButton", {
        Parent = row,
        Size = UDim2.new(0,140,1,0),
        Position = UDim2.new(0,130,0,0),
        BackgroundColor3 = Color3.fromRGB(70,70,80),
        BorderSizePixel = 0,
        Text = userKeybinds[action],
        TextColor3 = Color3.fromRGB(235,235,240),
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        AutoButtonColor = false,
    }, row)
    C("UICorner", { CornerRadius = UDim.new(0,8) }, btn)
    keyButtons[action] = btn
    
    btn.MouseButton1Click:Connect(function()
        -- Nếu đang chờ thì hủy
        if waitingForKey then
            cancelWaiting()
            return
        end
        
        -- Bắt đầu chờ đổi key
        waitingForKey = action
        btn.Text = "..."
        btn.BackgroundColor3 = Color3.fromRGB(130,130,80)
        
        -- Tạo listener mới
        if listenConn then listenConn:Disconnect() end
        listenConn = UIS.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if waitingForKey ~= action then return end
            
            local key = input.KeyCode
            if not key or key == Enum.KeyCode.Unknown then return end
            
            -- ESC để hủy
            if key == Enum.KeyCode.Escape then
                cancelWaiting()
                return
            end
            
            -- Lưu key mới
            local keyName = getKeyName(key)
            saveKey(action, keyName)
            cancelWaiting()
        end)
    end)
    
    return btn
end

