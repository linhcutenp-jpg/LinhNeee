-- ========== HÀM XỬ LÝ HOTKEY ==========
local keyStates = { Fly = false, Bring = false }

local function isKeyMatch(keyCode, keyName)
    if not keyCode or not keyName then return false end
    if keyName == "RightShift" then return keyCode == Enum.KeyCode.RightShift
    elseif keyName == "LeftShift" then return keyCode == Enum.KeyCode.LeftShift
    elseif keyName == "RightCtrl" then return keyCode == Enum.KeyCode.RightControl
    elseif keyName == "LeftCtrl" then return keyCode == Enum.KeyCode.LeftControl
    elseif keyName == "RightAlt" then return keyCode == Enum.KeyCode.RightAlt
    elseif keyName == "LeftAlt" then return keyCode == Enum.KeyCode.LeftAlt
    else return tostring(keyCode):gsub("Enum.KeyCode.", "") == keyName end
end

-- Hàm toggle script (bật/tắt toàn bộ)
local function toggleScriptState()
    scriptEnabled = not scriptEnabled
    if not scriptEnabled then
        if speedOn then speedBtn.MouseButton1Click() end
        if flying then toggleFly() end
        if noclip then noclipBtn.MouseButton1Click() end
        if esp then espBtn.MouseButton1Click() end
        if xray then xrayBtn.MouseButton1Click() end
        if infJump then infBtn.MouseButton1Click() end
        if not hidden then setHidden(true) end
    else
        if hidden then setHidden(false) end
    end
    -- Thông báo
    local msg = Instance.new("TextLabel")
    msg.Parent = screen
    msg.Text = scriptEnabled and "Script ON" or "Script OFF"
    msg.TextColor3 = Color3.fromRGB(255,255,255)
    msg.BackgroundColor3 = Color3.fromRGB(0,0,0)
    msg.BackgroundTransparency = 0.3
    msg.Position = UDim2.new(0.5, -100, 0.9, 0)
    msg.Size = UDim2.new(0, 200, 0, 30)
    msg.Font = Enum.Font.GothamBold
    msg.TextSize = 16
    C("UICorner", { CornerRadius = UDim.new(0,8) }, msg)
    task.delay(1.5, function() msg:Destroy() end)
end

-- Lắng nghe phím bấm
UIS.InputBegan:Connect(function(input, gameProcessed)
    -- Đang chờ đổi key thì không xử lý
    if waitingForKey then return end
    -- Đang chat hoặc game xử lý thì bỏ qua
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    local key = input.KeyCode
    if not key then return end
    
    -- Menu toggle
    if isKeyMatch(key, userKeybinds.ToggleMenu) then
        setHidden(not hidden)
        return
    end
    
    -- Script toggle
    if isKeyMatch(key, userKeybinds.ToggleScript) then
        toggleScriptState()
        return
    end
    
    -- Chỉ xử lý feature nếu script đang bật
    if not scriptEnabled then return end
    
    -- Fly
    if isKeyMatch(key, userKeybinds.Fly) and not keyStates.Fly then
        keyStates.Fly = true
        toggleFly()
        return
    end
    
    -- Bring
    if isKeyMatch(key, userKeybinds.Bring) and not keyStates.Bring then
        keyStates.Bring = true
        local name = bringBox and tostring(bringBox.Text):gsub("^%s*(.-)%s*$", "%1") or ""
        if name ~= "" then
            doBringPlayerByName(name)
        else
            local cam = Workspace.CurrentCamera
            if cam then
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Blacklist
                params.FilterDescendantsInstances = { lp.Character }
                local result = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 200, params)
                if result and result.Instance then
                    local model = result.Instance:FindFirstAncestorOfClass("Model")
                    if model then
                        local plr = Players:GetPlayerFromCharacter(model)
                        if plr and plr ~= lp then
                            doBringPlayerByName(plr.Name)
                        end
                    end
                end
            end
        end
        return
    end
end)

-- Reset key states khi thả phím
UIS.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode
    if isKeyMatch(key, userKeybinds.Fly) then
        keyStates.Fly = false
    elseif isKeyMatch(key, userKeybinds.Bring) then
        keyStates.Bring = false
    end
end)

