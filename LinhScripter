    if type(key) == "string" then return key end
    if key == Enum.KeyCode.RightShift then return "RightShift"
    elseif key == Enum.KeyCode.LeftShift then return "LeftShift"
    elseif key == Enum.KeyCode.RightControl then return "RightCtrl"
    elseif key == Enum.KeyCode.LeftControl then return "LeftCtrl"
    elseif key == Enum.KeyCode.RightAlt then return "RightAlt"
