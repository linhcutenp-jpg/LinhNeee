-- ===== AUTO PRESS SCRIPT FOR ROBLOX EXECUTOR =====
-- Phiên bản Hoàn thiện Tuyệt đối - Đạt chứng chỉ Tương thích ngược & Chống kẹt Trạng thái

local Settings = {
    keyToPress = "e",
    interval = 1,              -- Tính bằng giây (1 = 1000ms)
    enabled = false,
    currentVersion = 0,         -- Khóa bảo vệ phiên bản luồng (Anti-Race Condition)
    isClicking = false          -- Khóa trạng thái nhấn phím
}

local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local debounceF8 = false       -- Khóa chống spam dành riêng cho tầng vật lý (InputBegan)
local escDebounce = false      -- Khóa bảo vệ luồng độc lập cho phím Escape

-- HÀM KIỂM TRA INPUT VÀO
local function IsValidKey(key)
    if not key or type(key) ~= "string" or #key == 0 then return false end
    return true
end

-- HÀM NHẤN PHÍM (Đã hiệu chỉnh tính nhất quán của Trạng thái)
local function PressKey()
    if not Settings.enabled or Settings.isClicking or not IsValidKey(Settings.keyToPress) then return end
    
    Settings.isClicking = true
    
    -- Cầu chì bảo vệ: Tự động giải phóng trạng thái sau 100ms nếu luồng chính bị Executor kill
    local safetyThread = task.delay(0.1, function()
        Settings.isClicking = false
    end)
    
    pcall(function()
        if keypress and keyrelease then
            keypress(Settings.keyToPress)
            task.wait(0.005) -- Thời gian giữ phím vật lý
            keyrelease(Settings.keyToPress)
        end
    end)
    
    -- Chỉ can thiệp hủy hẹn giờ nếu cầu chì chưa bị kích hoạt (Chống trùng lắp logic)
    if Settings.isClicking then
        task.cancel(safetyThread)
        Settings.isClicking = false
    end
end

-- HÀM TẠO TIẾNG BEEP THÔNG BÁO
local function Beep(isActionOn)
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://130114051" 
        sound.PlaybackSpeed = isActionOn and 1.2 or 0.8
        sound.Volume = 0.4
        sound.Parent = workspace
        sound:Play()
        Debris:AddItem(sound, 0.5)
    end)
end

-- HÀM THÔNG BÁO UI SYSTEM
local function Notify(title, text, duration)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 1.2
        })
    end)
end

-- KHỞI CHẠY VÒNG LẶP TIMER
local function StartTimer()
    Settings.currentVersion = Settings.currentVersion + 1
    local myVersion = Settings.currentVersion
    
    task.spawn(function()
        while Settings.enabled and myVersion == Settings.currentVersion do
            task.wait(Settings.interval)
            if Settings.enabled and myVersion == Settings.currentVersion then 
                PressKey() 
            end
        end
    end)
end

-- LÕI THỰC THI BẬT/TẮT THUẦN TÚY (Đã tách biệt hoàn toàn khỏi Debounce)
local function ExecuteToggle(targetState)
    -- Nếu không truyền tham số, tự động đảo trạng thái (dùng cho phím tắt)
    if targetState == nil then
        Settings.enabled = not Settings.enabled
    else
        if Settings.enabled == targetState then return end -- Trùng trạng thái thì bỏ qua
        Settings.enabled = targetState
    end
    
    if Settings.enabled then
        PressKey()     -- 1. UX: Kích nổ phát đầu tiên ngay lập tức
        StartTimer()   -- 2. Đăng ký vòng lặp bất đồng bộ cho các phát sau
        
        Notify("Auto Press", "🔴 ON - [" .. string.upper(Settings.keyToPress) .. "] | " .. (Settings.interval * 1000) .. "ms", 1.2)
        Beep(true)
    else
        Settings.currentVersion = Settings.currentVersion + 1 -- Khai tử luồng chạy cũ ngay tại frame này
        Notify("Auto Press", "⚫ OFF", 1.2)
        Beep(false)
    end
end

-- XỬ LÝ SỰ KIỆN PHÍM TẮT (TẦNG PHẢN HỒI GIAO DIỆN)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local key = input.KeyCode
    
    -- 1. Tổ hợp hệ thống: Ctrl + F8 (Reset Hoàn Toàn)
    if key == Enum.KeyCode.F8 and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        Settings.keyToPress = "e"
        Settings.interval = 1 
        Settings.enabled = false
        Settings.currentVersion = Settings.currentVersion + 1 -- Sát hạch luồng loop
        
        -- FIX V4: Giải phóng triệt để các chốt chặn khóa để tránh kẹt vĩnh viễn
        debounceF8 = false
        escDebounce = false
        
        Notify("Reset", "🔄 RESET TO DEFAULT\nKey: E | Interval: 1000ms", 1.5)
        Beep(true)
        
    -- 2. Phím đơn: F8 (Bật/Tắt)
    elseif key == Enum.KeyCode.F8 then
        if debounceF8 then return end
        debounceF8 = true
        
        ExecuteToggle()
        
        task.delay(0.2, function() debounceF8 = false end)
        
    -- F4: Hướng dẫn nhập trực tiếp Interval
    elseif key == Enum.KeyCode.F4 then
        Notify("Set Interval", "Dùng console gõ:\n_G.AutoPress.SetInterval(số_ms)", 2)
        
    -- F7: TĂNG TỐC (Giảm chu kỳ 10%)
    elseif key == Enum.KeyCode.F7 then
        local oldInterval = Settings.interval
        Settings.interval = math.max(0.001, Settings.interval * 0.9)
        
        if Settings.interval ~= oldInterval then
            Settings.currentVersion = Settings.currentVersion + 1 -- Dập luồng cũ tức thì
            if Settings.enabled then StartTimer() end
            Notify("Speed +", string.format("%.0fms (Was %.0fms)", Settings.interval * 1000, oldInterval * 1000), 0.8)
        else
            Notify("Speed +", "⚡ Already at minimum (1ms)", 0.8)
        end
        
    -- F6: GIẢM TỐC (Tăng chu kỳ 10%)
    elseif key == Enum.KeyCode.F6 then
        local oldInterval = Settings.interval
        Settings.interval = math.min(60, Settings.interval * 1.1)
        
        if Settings.interval ~= oldInterval then
            Settings.currentVersion = Settings.currentVersion + 1 -- Dập luồng cũ
            if Settings.enabled then StartTimer() end
            Notify("Speed -", string.format("%.0fms (Was %.0fms)", Settings.interval * 1000, oldInterval * 1000), 0.8)
        else
            Notify("Speed -", "🐢 Already at maximum (60000ms)", 0.8)
        end
        
    -- F5: Hướng dẫn đổi phím
    elseif key == Enum.KeyCode.F5 then
        Notify("Change Key", "Dùng console gõ:\n_G.AutoPress.SetKey('tên_phím')", 2)
        
    -- Esc giữ 1 giây: Khai tử Script (Đã có khóa bảo vệ Thread-Spam)
    elseif key == Enum.KeyCode.Escape then
        if escDebounce then return end
        escDebounce = true
        
        task.spawn(function()
            local holdTime = 0
            while UserInputService:IsKeyDown(Enum.KeyCode.Escape) do
                task.wait(0.1)
                holdTime = holdTime + 0.1
                if holdTime >= 1.0 then
                    Settings.enabled = false
                    Settings.currentVersion = Settings.currentVersion + 1
                    Notify("Auto Press", "🛑 SCRIPT TERMINATED", 1.5)
                    Beep(false)
                    break
                end
            end
            escDebounce = false -- Giải phóng khóa sau khi người dùng nhả phím hoặc tắt script
        end)
    end
end)

-- INTERFACE ĐIỀU KHIỂN BÊN NGOÀI (_G API)
_G.AutoPress = {
    Start = function() ExecuteToggle(true) end,
    Stop = function() ExecuteToggle(false) end,
    SetKey = function(key)
        local keyStr = tostring(key):lower()
        if IsValidKey(keyStr) then
            Settings.keyToPress = keyStr
            Notify("Auto Press", "🔑 Changed key to: " .. Settings.keyToPress, 1)
        else
            Notify("Auto Press", "⚠️ Phím nhập vào không hợp lệ!", 1.5)
        end
    end,
    SetInterval = function(ms)
        if type(ms) == "number" and ms > 0 then
            local targetSeconds = ms / 1000
            
            -- FIX V4: Thay thế math.clamp bằng math.max/min để tương thích ngược hoàn toàn với Lua 5.1
            local clampedSeconds = math.max(0.001, math.min(60, targetSeconds))
            
            Settings.interval = clampedSeconds
            Settings.currentVersion = Settings.currentVersion + 1 -- Ngắt kết nối loop cũ
            
            if Settings.enabled then StartTimer() end
            
            local finalMs = clampedSeconds * 1000
            if targetSeconds ~= clampedSeconds then
                Notify("Auto Press", "📊 Đã giới hạn! Interval set to: " .. finalMs .. "ms", 1.8)
            else
                Notify("Auto Press", "📊 Interval set to: " .. finalMs .. "ms", 1)
            end
        else
            Notify("Auto Press", "⚠️ Interval phải là số dương!", 1.5)
        end
    end,
    GetStatus = function()
        return { enabled = Settings.enabled, key = Settings.keyToPress, interval_ms = Settings.interval * 1000 }
    end
}

-- KHỞI TẠO HỆ THỐNG
Notify("Auto Press", "✅ Script Loaded | Press F8 to Start", 2)
