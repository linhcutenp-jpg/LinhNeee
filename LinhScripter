local function doBringPlayerByName(name)
    if bringPlayerDebounce then return end
    bringPlayerDebounce = true
    task.delay(0.6, function() bringPlayerDebounce = false end)

    name = tostring(name or ""):gsub("^%s*(.-)%s*$", "%1")
    if name == "" then flashBtn(bringPlayerBtn2, "Empty", 0.8); return end

    local function findPlayerByPartialLocal(namePart)
        namePart = string.lower(namePart or "")
        for _, plr in ipairs(Players:GetPlayers()) do
            if string.find(string.lower(plr.Name), namePart, 1, true) and plr ~= lp then return plr end
        end
        return nil
    end

    local target = findPlayerByPartialLocal(name)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        flashBtn(bringPlayerBtn2, "Not Found", 1.2); return
    end
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then flashBtn(bringPlayerBtn2, "No HRP", 1.2); return end

    local destPos = myHRP.Position + (myHRP.CFrame.LookVector * 3) + Vector3.new(0, 1.2, 0)
    pcall(function()
        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            target.Character.HumanoidRootPart.CFrame = CFrame.new(destPos, destPos + myHRP.CFrame.LookVector)
        end
    end)
    flashBtn(bringPlayerBtn2, "Done", 1)
end

