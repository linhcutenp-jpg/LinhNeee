-- ESP functions
local function getESPColor(plr)
    if plr.Team and plr.Team.TeamColor then return plr.Team.TeamColor.Color end
    return Color3.fromRGB(255, 85, 0)
end

local function updateESPColor(plr)
    local data = espData[plr]
    if not data or not data.highlight then return end
    local color = getESPColor(plr)
    data.highlight.FillColor = color
    if data.nameTag and data.nameTag.TextLabel then data.nameTag.TextLabel.TextColor3 = color end
end

local function removeESP(plr)
    local data = espData[plr]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.nameTag then pcall(function() data.nameTag:Destroy() end) end
    if data.teamChangedConn then pcall(function() data.teamChangedConn:Disconnect() end) end
    if data.teamConn then pcall(function() data.teamConn:Disconnect() end) end
    if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
    espData[plr] = nil
end

local function createESPForPlayer(plr)
    if plr == lp or not esp then return end
    if espData[plr] then removeESP(plr) end
    
    local char = plr.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp or not head then return end
    
    local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if myHrp and (myHrp.Position - hrp.Position).Magnitude > ESP_DISTANCE then return end
    if not esp then return end
    
    local color = getESPColor(plr)
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.FillTransparency = ESP_FILL_TRANSPARENCY
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char
    
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 120, 0, 20)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = color
    nameLabel.TextScaled = true
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = billboard
    
    local teamChangedConn
    if plr.Team then
        teamChangedConn = plr.Team:GetPropertyChangedSignal("TeamColor"):Connect(function() updateESPColor(plr) end)
    end
    local teamConn = plr:GetPropertyChangedSignal("Team"):Connect(function()
        updateESPColor(plr)
        if plr.Team then
            if teamChangedConn then pcall(function() teamChangedConn:Disconnect() end) end
            teamChangedConn = plr.Team:GetPropertyChangedSignal("TeamColor"):Connect(function() updateESPColor(plr) end)
        end
    end)
    
    local charAddedConn = plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if esp then
            if espData[plr] then removeESP(plr) end
            createESPForPlayer(plr)
        end
    end)
    
    espData[plr] = { highlight = highlight, nameTag = billboard, teamChangedConn = teamChangedConn, teamConn = teamConn, charAddedConn = charAddedConn }
end

local function updateAllESP()
    if not esp then
        for plr, _ in pairs(espData) do removeESP(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do if plr ~= lp then createESPForPlayer(plr) end end
end

