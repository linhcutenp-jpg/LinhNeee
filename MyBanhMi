    -- ==================== NOCLIP ====================
    local originalCollisions = {}
    local charParts = {}
    local lastNoclipTime = 0

    local function refreshCharPartsCache(char)
        table.clear(charParts)
        if not char then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                table.insert(charParts, part)
                if originalCollisions[part] == nil then
                    originalCollisions[part] = part.CanCollide
                end
            end
        end
    end

    local function updateNoclip()
        local char = lp.Character
        if not state.noclip or not char or #charParts == 0 then return end
        if os.time() - lastNoclipTime < 0.1 then return end
        lastNoclipTime = os.time()
        if state.silentNoclip then
            local params = OverlapParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {char}
            for _, part in ipairs(charParts) do
                if part and part.Parent and part.Name == "HumanoidRootPart" then
                    local touching = Workspace:GetPartsInPart(part, params)
                    if #touching > 0 then
                        for _, p in ipairs(charParts) do if p then p.CanCollide = false end end
                    else
                        for _, p in ipairs(charParts) do if p then p.CanCollide = originalCollisions[p] or true end end
                    end
                    break
                end
            end
        else
            for _, part in ipairs(charParts) do
                if part and part.Parent and part.CanCollide then part.CanCollide = false end
            end
        end
    end

