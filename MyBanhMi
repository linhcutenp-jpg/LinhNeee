        -- Tab switching
        local navBtns = {}
        local currentTab = "player"
        
        local function MakeNavBtn(icon, label, tabKey, yPos)
            local btn = MakeButton({Size=UDim2.new(1,-12,0,56), Position=UDim2.new(0,6,0,yPos), BackgroundColor3=Colors.Sidebar, BackgroundTransparency=1, Text="", Parent=sidebar})
            if not btn then return nil end
            MakeCorner(btn,6)
            local stroke = MakeStroke(btn, Color3.fromRGB(0,0,0), 1)
            if stroke then stroke.Transparency = 1 end
            MakeLabel({Size=UDim2.new(1,0,0,24), Position=UDim2.new(0,0,0,6), Text=icon, TextSize=20, TextColor3=Colors.TextSec, TextXAlignment=Enum.TextXAlignment.Center, Parent=btn})
            local lbl = MakeLabel({Size=UDim2.new(1,0,0,16), Position=UDim2.new(0,0,0,30), Text=label, TextSize=10, TextColor3=Colors.TextSec, TextXAlignment=Enum.TextXAlignment.Center, Parent=btn})
            btn.MouseButton1Click:Connect(function()
                currentTab = tabKey
                for _, nb in pairs(navBtns) do
                    if nb and nb.btn then
                        local active = (nb.key == tabKey)
                        TweenService:Create(nb.btn, TweenInfo.new(0.15), {BackgroundTransparency = active and 0 or 1, BackgroundColor3 = active and Color3.fromRGB(108,71,255) or Colors.Sidebar}):Play()
                        if nb.stroke then nb.stroke.Transparency = active and 0.7 or 1 end
                        if nb.lbl then nb.lbl.TextColor3 = active and Color3.fromRGB(168,139,255) or Colors.TextSec end
                    end
                end
                if tabKey == "player" then BuildPlayerTab()
                elseif tabKey == "misc" then BuildMiscTab()
                elseif tabKey == "tools" then BuildToolsTab()
                elseif tabKey == "settings" then BuildSettingsTab() end
            end)
            return { btn = btn, stroke = stroke, lbl = lbl, key = tabKey }
        end

        local navData = MakeNavBtn("👤", "Player", "player", 12)
        if navData then table.insert(navBtns, navData) end
        navData = MakeNavBtn("⚙", "Misc", "misc", 12+64)
        if navData then table.insert(navBtns, navData) end
        navData = MakeNavBtn("🧰", "Tools", "tools", 12+128)
        if navData then table.insert(navBtns, navData) end
        navData = MakeNavBtn("🔧", "Settings", "settings", 12+192)
        if navData then table.insert(navBtns, navData) end

        BuildPlayerTab()
        updateActiveCounter()
    end

    -- ==================== ANTI-AFK, REJOIN ====================
    local function startAntiAFK()
        registerConnection("AntiAFK", lp.Idled:Connect(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
        end))
    end
    local function stopAntiAFK() clearConnection("AntiAFK") end

    local function startRejoinKick()
        registerConnection("RejoinKick", lp.OnTeleport:Connect(function(state)
            if state == Enum.TeleportState.Failed then
                task.wait(3)
                pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
            end
        end))
    end
    local function stopRejoinKick() clearConnection("RejoinKick") end

    local function startAutoRejoin() misc.autoRejoin = true end

    -- ==================== HOTKEY ====================
    registerConnection("UIToggle", UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then
            if screenGui then screenGui.Enabled = not screenGui.Enabled end
        end
    end))

    CAS:BindAction("FlyKey", function(_, actionState)
        if actionState == Enum.UserInputState.Begin then toggleFly() end
    end, false, Enum.KeyCode.B)

    -- ==================== INIT ====================
    setupUI()
    if misc.antiAFK then startAntiAFK() end
    if misc.rejoinKick then startRejoinKick() end
    if misc.autoRejoin then startAutoRejoin() end
    if state.esp then enableESP() end
    if state.xray then toggleXray() end
    if state.noclip and lp.Character then refreshCharPartsCache(lp.Character) end
    syncFlyButton()
    updateActiveCounter()

    -- ==================== CLEANUP ====================
    local function cleanupAll()
        print("[System] Unloading...")
        state.scriptEnabled = false
        stopFly()
        if state.xray then toggleXray() end
        for id, conn in pairs(ConnectionRegistry) do
            if conn then pcall(function() conn:Disconnect() end) end
        end
        table.clear(ConnectionRegistry)
        disableESP()
        for _, data in pairs(lootBillboards) do if data.bb then data.bb:Destroy() end end
        table.clear(lootBillboards)
        if screenGui then screenGui:Destroy() end
        if jumpLockConnection then jumpLockConnection:Disconnect() end
        if jumpStateChangedConn then jumpStateChangedConn:Disconnect() end
        if speedHeartbeatConn then speedHeartbeatConn:Disconnect() end
        if speedPropertyListener then speedPropertyListener:Disconnect() end
        print("[System] Cleanup complete.")
    end

    _G.UnloadLinhScript = cleanupAll

    print("=" .. string.rep("=", 60))
    print("Linh Script Premium v10.8 - COMPLETE FIXED EDITION Loaded!")
    print("All bugs fixed: Fly orientation, Memory leaks, Speed restore, etc.")
    print("Hotkey: Right Shift / INSERT (Menu) | B (Fly)")
    print("Fly Modes: Physics / CFrame / Humanoid")
    print("To unload: _G.UnloadLinhScript()")
    print("=" .. string.rep("=", 60))
end)()
