    local jumpLockConnection = nil
    local speedHeartbeatConn = nil

    -- ==================== CONNECTION MANAGER ====================
    local ConnectionRegistry = {}
    local function registerConnection(id, conn)
        if ConnectionRegistry[id] then
            pcall(function() ConnectionRegistry[id]:Disconnect() end)
            ConnectionRegistry[id] = nil
        end
        ConnectionRegistry[id] = conn
        return conn
    end
    local function clearConnection(id)
        if ConnectionRegistry[id] then
            pcall(function() ConnectionRegistry[id]:Disconnect() end)
            ConnectionRegistry[id] = nil
        end
    end

    -- ==================== HELPER FUNCTIONS ====================
    local function getRoot(char) return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart) end
    local function isHumanoidValid(h) return h and h.Parent and h.Parent:IsA("Model") and h.Parent.Parent == Workspace end

    local function getPartNetworkOwner(part)
        if not part then return "Invalid" end
        if part.Anchored then return "Static" end
        local success, owner = pcall(function() return part:GetNetworkOwner() end)
        if not success then return "Unknown" end
        if owner == lp then return "Client (You)" end
        if owner == nil then return "Server" end
        return "Player: " .. owner.Name
    end

    local function isCharacterPart(part)
        if not part then return false end
        local model = part:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then return true end
        if part.Parent:IsA("Accessory") and part.Parent.Parent then
            if Players:GetPlayerFromCharacter(part.Parent.Parent) then return true end
        end
        return false
    end

    local function C(class, props, parent)
        local obj = Instance.new(class)
        if props then for k, v in pairs(props) do pcall(function() obj[k] = v end) end end
        if parent then obj.Parent = parent end
        return obj
    end

    -- ==================== SAVE/LOAD ====================
    local CONFIG_KEY = "LinhScriptPremiumConfig.json"
    local function hasFileIO() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" end
    
    local function SaveConfig()
        if not misc.autoSave or not hasFileIO() then return end
        pcall(function()
            writefile(CONFIG_KEY, HttpService:JSONEncode({
                speedOn = state.speedOn, speedValue = state.speedValue,
                jumpEnabled = state.jumpEnabled, jumpHeight = state.jumpHeight,
                infJump = state.infJump, multiJump = state.multiJump,
                noclip = state.noclip, silentNoclip = state.silentNoclip,
                esp = state.esp, lootEsp = state.lootEsp, xray = state.xray,
                flySpeed = state.flySpeed, flyMode = state.flyMode,
                xrayIntensity = state.xrayIntensity,
                lockToMeEnabled = state.lockToMeEnabled, freezeEnabled = state.freezeEnabled,
                antiAFK = misc.antiAFK, rejoinKick = misc.rejoinKick, autoRejoin = misc.autoRejoin,
                guiOpacity = misc.guiOpacity,
            }))
        end)
    end
    
    local function LoadConfig()
        if not hasFileIO() then return end
        pcall(function()
            if isfile(CONFIG_KEY) then
                local data = HttpService:JSONDecode(readfile(CONFIG_KEY))
                if type(data) == "table" then
                    for k, v in pairs(data) do
                        if state[k] ~= nil then state[k] = v end
                        if misc[k] ~= nil then misc[k] = v end
                    end
                end
            end
        end)
    end
    LoadConfig()

    -- ==================== SPEED SYSTEM (FIXED) ====================
    local function applySpeed()
        local char = lp.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        if state.speedOn then
            hum.WalkSpeed = state.speedValue
        else
            hum.WalkSpeed = originalWalkSpeed
        end
    end
    
    -- Ghi nhớ tốc độ gốc khi nhân vật xuất hiện
    local function updateOriginalSpeed(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            originalWalkSpeed = hum.WalkSpeed
        end
    end
    
    -- Speed heartbeat connection (chạy liên tục khi bật)
    local function updateSpeedHeartbeat()
        if speedHeartbeatConn then
            speedHeartbeatConn:Disconnect()
            speedHeartbeatConn = nil
        end
        
        if state.speedOn then
            speedHeartbeatConn = RunService.Heartbeat:Connect(function()
                local char = lp.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.WalkSpeed ~= state.speedValue then
                        hum.WalkSpeed = state.speedValue
                    end
                end
            end)
            registerConnection("SpeedHeartbeat", speedHeartbeatConn)
        end
    end
    
    -- Speed property listener (phát hiện game đè)
    local speedPropertyListener = nil
    local function hookSpeedListener(char)
        if speedPropertyListener then speedPropertyListener:Disconnect() end
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            speedPropertyListener = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if state.speedOn and hum.WalkSpeed ~= state.speedValue then
                    hum.WalkSpeed = state.speedValue
                elseif not state.speedOn then
                    originalWalkSpeed = hum.WalkSpeed
                end
            end)
        end
    end
    
    -- Toggle speed (có lưu giá trị gốc)
    local function toggleSpeed()
        state.speedOn = not state.speedOn
        
        if state.speedOn then
            -- Lưu tốc độ gốc trước khi thay đổi
            local char = lp.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    originalWalkSpeed = hum.WalkSpeed
                end
            end
            updateSpeedHeartbeat()
        else
            -- Tắt heartbeat
            if speedHeartbeatConn then
                speedHeartbeatConn:Disconnect()
                speedHeartbeatConn = nil
            end
            clearConnection("SpeedHeartbeat")
            -- Khôi phục tốc độ gốc
            local char = lp.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = originalWalkSpeed
                end
            end
        end
        updateActiveCounter()
        SaveConfig()
    end

    -- Khởi tạo speed
    lp.CharacterAdded:Connect(function(char)
        updateOriginalSpeed(char)
        hookSpeedListener(char)
        if state.speedOn then
            updateSpeedHeartbeat()
        end
    end)
    if lp.Character then
        updateOriginalSpeed(lp.Character)
        hookSpeedListener(lp.Character)
        if state.speedOn then updateSpeedHeartbeat() end
    end

    -- ==================== JUMP MODULE ====================
    local jumpCount = 0
    local currentHumanoid = nil
    local currentJumpMethod = "Power"
    local lastJumpReset = 0

    local function detectJumpMethod(hum) return hum.UseJumpPower and "Power" or "Height" end

    local function lockJumpValue(hum)
        if jumpLockConnection then jumpLockConnection:Disconnect() end
        if not hum then return end
        local target = math.min(state.jumpHeight, Config.MAX_SAFE_JUMP_POWER)
        jumpLockConnection = hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if state.jumpEnabled and hum.JumpPower ~= target then hum.JumpPower = target end
        end)
    end

    local function enforceJumpValue(hum)
        if not state.jumpEnabled or not hum or not isHumanoidValid(hum) then return end
        if time() - lastJumpReset < 0.15 then return end
        lastJumpReset = time()
        local target = math.min(state.jumpHeight, Config.MAX_SAFE_JUMP_POWER)
        if currentJumpMethod == "Height" then
            if hum.JumpHeight ~= target then hum.JumpHeight = target; hum.UseJumpPower = false end
        else
            if hum.JumpPower ~= target then hum.JumpPower = target; hum.UseJumpPower = true end
        end
        lockJumpValue(hum)
    end

    local function restoreJumpBase()
        if currentHumanoid and originalJumpSettings.JumpPower then
            currentHumanoid.UseJumpPower = originalJumpSettings.UseJumpPower
            currentHumanoid.JumpPower = originalJumpSettings.JumpPower
            currentHumanoid.JumpHeight = originalJumpSettings.JumpHeight
            if jumpLockConnection then jumpLockConnection:Disconnect() end
        end
    end

    local function doJump()
        local char = lp.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum:GetState() == Enum.HumanoidStateType.Dead then return end
        if hum:GetState() == Enum.HumanoidStateType.Jumping then return end
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        if currentJumpMethod == "Height" then
            local vel = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(vel.X, state.jumpHeight / 2.5, vel.Z)
        end
    end

    UIS.JumpRequest:Connect(function()
        local char = lp.Character
        if not char then return end
        if state.infJump then
            doJump()
        elseif state.multiJump and jumpCount < 2 then
            doJump()
            jumpCount = jumpCount + 1
        end
    end)

    lp.CharacterAdded:Connect(function(char)
        jumpCount = 0
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            currentHumanoid = hum
            currentJumpMethod = detectJumpMethod(hum)
            originalJumpSettings.UseJumpPower = hum.UseJumpPower
            originalJumpSettings.JumpPower = hum.JumpPower
            originalJumpSettings.JumpHeight = hum.JumpHeight
            enforceJumpValue(hum)
            hum.StateChanged:Connect(function(_, newState)
                if newState == Enum.HumanoidStateType.Landed then jumpCount = 0
                elseif newState == Enum.HumanoidStateType.Jumping then jumpCount = jumpCount + 1 end
            end)
        end
        if state.noclip then refreshCharPartsCache(char) end
        if state.flying then
            stopFly()
            startFly()
        end
    end)

    if lp.Character then
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            currentHumanoid = hum
            currentJumpMethod = detectJumpMethod(hum)
            originalJumpSettings.UseJumpPower = hum.UseJumpPower
            originalJumpSettings.JumpPower = hum.JumpPower
            originalJumpSettings.JumpHeight = hum.JumpHeight
            enforceJumpValue(hum)
        end
    end

    -- ==================== FLY SYSTEM V24 (PC-ONLY, FIXED LEAKS) ====================
    local flyLinearVel = nil
    local flyAlignOri = nil
    local flyAttach = nil
    local flyHeartbeatConn = nil
    local flyRenderConn = nil
    local cachedHumanoid = nil
    local cachedRoot = nil
    local flyRebuildToken = 0
    local isRebuilding = false
    local resumeFailureCount = 0
    local MAX_RESUME_FAILURE = 3
    local rebuildRetryCount = 0
    local MAX_REBUILD_RETRY = 10
    local isResuming = false
    local isBuildingComponents = false  -- Chống duplicate

    local function getCameraRotationFly()
        local cam = Workspace.CurrentCamera
        if not cam then return CFrame.identity end
        local cf = cam.CFrame
        return CFrame.fromMatrix(Vector3.new(0,0,0), cf.RightVector, cf.UpVector, -cf.LookVector)
    end

    local function setOrientationEnabledFly(enabled)
        if flyAlignOri then pcall(function() flyAlignOri.Enabled = enabled end) end
    end

    local function refreshFlyCaches()
        local char = lp.Character
        if not char then
            cachedHumanoid = nil
            cachedRoot = nil
            return
        end
        cachedHumanoid = char:FindFirstChildOfClass("Humanoid")
        cachedRoot = char:FindFirstChild("HumanoidRootPart")
    end

    local function cleanupFlyComponents(root)
        if not root then return end
        for _, v in ipairs(root:GetChildren()) do
            local name = v.Name
            if name == "LinhFlyAttachment" or name == "LinhFlyLinearVelocity" or name == "LinhFlyAlignOrientation" then
                pcall(function() v:Destroy() end)
            end
        end
    end

    local function ensureFlyComponents(root)
        if not root then return false end
        if root ~= cachedRoot then return false end
        if root.Parent ~= lp.Character then return false end
        if isBuildingComponents then return false end
        
        isBuildingComponents = true
        cleanupFlyComponents(root)
        
        flyAttach = Instance.new("Attachment")
        flyAttach.Name = "LinhFlyAttachment"
        
        flyLinearVel = Instance.new("LinearVelocity")
        flyLinearVel.Name = "LinhFlyLinearVelocity"
        flyLinearVel.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        flyLinearVel.VectorVelocity = Vector3.new(0,0,0)
        flyLinearVel.Attachment0 = flyAttach
        flyLinearVel.RelativeTo = Enum.ActuatorRelativeTo.World
        flyLinearVel.Enabled = true
        
        flyAlignOri = Instance.new("AlignOrientation")
        flyAlignOri.Name = "LinhFlyAlignOrientation"
        flyAlignOri.RigidityEnabled = true
        flyAlignOri.Responsiveness = 55
        flyAlignOri.Attachment0 = flyAttach
        flyAlignOri.Enabled = true
        
        flyAttach.Parent = root
        flyLinearVel.Parent = root
        flyAlignOri.Parent = root
        
        isBuildingComponents = false
        return true
    end

    -- Dừng fly - disconnect tất cả connections
    local function pauseFlyState()
        if flyRenderConn then
            pcall(function() flyRenderConn:Disconnect() end)
            flyRenderConn = nil
        end
        if flyHeartbeatConn then
            pcall(function() flyHeartbeatConn:Disconnect() end)
            flyHeartbeatConn = nil
        end
        if flyLinearVel then
            pcall(function() 
                flyLinearVel.Enabled = false
                flyLinearVel.VectorVelocity = Vector3.new(0,0,0)
            end)
        end
        if flyAlignOri then
            pcall(function() flyAlignOri.Enabled = false end)
        end
        setOrientationEnabledFly(false)
    end

    local function startPhysicsFly()
        local char = lp.Character
        if not char then return false end
        refreshFlyCaches()
        if not cachedHumanoid or not cachedRoot then return false end
        if cachedRoot.Parent ~= char then return false end
        if not ensureFlyComponents(cachedRoot) then return false end
        setOrientationEnabledFly(true)
        pauseFlyState()
        cachedHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
        
        flyHeartbeatConn = RunService.Heartbeat:Connect(function()
            if not state.flying then
                if flyLinearVel then 
                    flyLinearVel.VectorVelocity = Vector3.new(0,0,0)
                    flyLinearVel.Enabled = false
                end
                return
            end
            local currentChar = lp.Character
            if not currentChar then return end
            if not cachedRoot or cachedRoot.Parent ~= currentChar then
                refreshFlyCaches()
                if not cachedRoot then return end
            end
            if not flyLinearVel or not flyLinearVel.Parent then
                if not ensureFlyComponents(cachedRoot) then
                    scheduleRebuildFly()
                    return
                end
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local camCF = cam.CFrame
            local moveDir = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * math.min(state.flySpeed, Config.FLY_SPEED_MAX) end
            if flyLinearVel then 
                flyLinearVel.Enabled = true
                flyLinearVel.VectorVelocity = moveDir 
            end
        end)
        
        flyRenderConn = RunService.RenderStepped:Connect(function()
            if state.flying and flyAlignOri and flyAlignOri.Parent then
                flyAlignOri.CFrame = getCameraRotationFly()
            end
        end)
        
        registerConnection("FlightEngineLoop", flyHeartbeatConn)
        registerConnection("CameraOrientationLoop", flyRenderConn)
        return true
    end

    local function startCFrameFly()
        local char = lp.Character
        if not char then return false end
        refreshFlyCaches()
        if not cachedHumanoid or not cachedRoot then return false end
        if cachedRoot.Parent ~= char then return false end
        cleanupFlyComponents(cachedRoot)
        flyLinearVel = nil
        flyAlignOri = nil
        flyAttach = nil
        cachedHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
        pauseFlyState()
        
        flyHeartbeatConn = RunService.RenderStepped:Connect(function(deltaTime)
            if not state.flying then return end
            local currentChar = lp.Character
            if not currentChar then return end
            if not cachedRoot or cachedRoot.Parent ~= currentChar then
                refreshFlyCaches()
                if not cachedRoot then return end
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            cachedRoot.AssemblyLinearVelocity = Vector3.new(0,0,0)
            local moveDir = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
            if moveDir.Magnitude > 0 then
                cachedRoot.CFrame = cachedRoot.CFrame + (moveDir.Unit * (math.min(state.flySpeed, Config.FLY_SPEED_MAX) * deltaTime * 2))
            end
        end)
        registerConnection("FlightEngineLoop", flyHeartbeatConn)
        return true
    end

    local function startHumanoidFly()
        local char = lp.Character
        if not char then return false end
        refreshFlyCaches()
        if not cachedHumanoid or not cachedRoot then return false end
        if cachedRoot.Parent ~= char then return false end
        cleanupFlyComponents(cachedRoot)
        flyLinearVel = nil
        flyAlignOri = nil
        flyAttach = nil
        cachedHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        pauseFlyState()
        
        local lastVel = Vector3.new(0,0,0)
        flyHeartbeatConn = RunService.RenderStepped:Connect(function()
            if not state.flying then return end
            local currentChar = lp.Character
            if not currentChar then return end
            if not cachedRoot or cachedRoot.Parent ~= currentChar then
                refreshFlyCaches()
                if not cachedRoot then return end
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local moveDir = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
            if moveDir.Magnitude > 0 then lastVel = moveDir.Unit * math.min(state.flySpeed, Config.FLY_SPEED_MAX) end
            cachedRoot.AssemblyLinearVelocity = lastVel
        end)
        registerConnection("FlightEngineLoop", flyHeartbeatConn)
        return true
    end

    local function startFly()
        if state.flyMode == "Physics" then
            return startPhysicsFly()
        elseif state.flyMode == "CFrame" then
            return startCFrameFly()
        elseif state.flyMode == "Humanoid" then
            return startHumanoidFly()
        end
        return false
    end

    local function stopFly()
        if isResuming then return end
        state.flying = false
        pauseFlyState()
        clearConnection("FlightEngineLoop")
        clearConnection("CameraOrientationLoop")
        local char = lp.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then cleanupFlyComponents(root) end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum.PlatformStand = false
            end
        end
        flyLinearVel = nil
        flyAlignOri = nil
        flyAttach = nil
        cachedHumanoid = nil
        cachedRoot = nil
    end
