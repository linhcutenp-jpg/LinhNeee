                local bSelectConn = mouse.Button1Down:Connect(function()
                    local target = mouse.Target
                    clearConnection("BringSelectMouse")
                    selectPartBtn.Text = "🎯 Select"
                    if target then
                        if isCharacterPart(target) then
                            if partInfoLabel then partInfoLabel.Text = "⚠️ Cannot select player parts!" end
                            return
                        end
                        if selectedPart then lastSelectedPart = selectedPart end
                        selectedPart = target
                        applySelectionBoxToPart(selectedPart)
                        updateObjectScannerUI()
                    end
                end)
                registerConnection("BringSelectMouse", bSelectConn)
            end)

            searchByNameBtn.MouseButton1Click:Connect(function()
                local name = partNameBox.Text
                if name == "" then
                    if partInfoLabel then partInfoLabel.Text = "⚠️ Please enter a part name!" end
                    return
                end
                if partInfoLabel then partInfoLabel.Text = "🔍 Searching..." end
                task.spawn(function()
                    local found = Workspace:FindFirstChild(name, true)
                    if found and found:IsA("BasePart") then
                        if selectedPart then lastSelectedPart = selectedPart end
                        selectedPart = found
                        applySelectionBoxToPart(selectedPart)
                        updateObjectScannerUI()
                        if partInfoLabel then partInfoLabel.Text = string.format("✅ Found: %s", found.Name) end
                    else
                        if partInfoLabel then partInfoLabel.Text = "❌ No part named: " .. name end
                    end
                    partNameBox.Text = ""
                end)
            end)

