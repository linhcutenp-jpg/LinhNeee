                updateAnchoredButtonUI()
                if partInfoLabel then partInfoLabel.Text = newState and "🔒 Part anchored!" or "🔓 Part unanchored!" end
                updateObjectScannerUI()
            end)

            resetAnchoredBtn.MouseButton1Click:Connect(function()
                if not selectedPart or not selectedPart.Parent then
                    if partInfoLabel then partInfoLabel.Text = "⚠️ No part selected!" end
                    return
                end
                if originalAnchoredState == nil then originalAnchoredState = false end
                pcall(function() selectedPart.Anchored = originalAnchoredState end)
                updateAnchoredButtonUI()
                if partInfoLabel then partInfoLabel.Text = originalAnchoredState and "🔒 Restored anchored state!" or "🔓 Restored unanchored state!" end
                updateObjectScannerUI()
            end)

            MakeLabel({Size=UDim2.new(1,0,0,24), Text="--- Physics Sandbox Environment ---", TextSize=12, TextColor3=Color3.fromRGB(210,120,40), Font=Enum.Font.GothamBold, TextXAlignment=Enum.TextXAlignment.Center, Parent=scroll})

            local sandActionsRow = MakeFrame({Size=UDim2.new(1,0,0,36), BackgroundTransparency=1, Parent=scroll})
            lockToMeBtn = MakeButton({Size=UDim2.new(0,180,1,0), BackgroundColor3=Color3.fromRGB(70,70,80), Text="🔒 Lock to Me: OFF", TextSize=11, TextColor3=Colors.White, Parent=sandActionsRow})
            MakeCorner(lockToMeBtn,8)
            freezeBtn = MakeButton({Size=UDim2.new(0,180,1,0), Position=UDim2.new(0,195,0,0), BackgroundColor3=Color3.fromRGB(70,70,80), Text="🥶 Freeze: OFF", TextSize=11, TextColor3=Colors.White, Parent=sandActionsRow})
            MakeCorner(freezeBtn,8)

