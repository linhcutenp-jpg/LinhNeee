    local function setupCharacterSignals(char)
        clearConnection("CharDescendantAdded")
        clearConnection("CharDescendantRemoving")
        if not char then return end

        refreshCharacterPartsCache(char)
        hookMultiJumpState(char)

        local addedC = char.DescendantAdded:Connect(function(p)
            if p:IsA("BasePart") then
                table.insert(characterPartsCache, p)
                if originalCollisions[p] == nil then
                    originalCollisions[p] = p.CanCollide
                end
                if state.noclip then
                    p.CanCollide = false
                end
            end
        end)
        registerConnection("CharDescendantAdded", addedC)

        local remC = char.DescendantRemoving:Connect(function(p)
            local idx = table.find(characterPartsCache, p)
            if idx then
                table.remove(characterPartsCache, idx)
            end
        end)
        registerConnection("CharDescendantRemoving", remC)
    end

    local mainCharacterAdded = lp.CharacterAdded:Connect(function(char)
        task.wait(0.2)
        table.clear(originalCollisions)
        table.clear(characterPartsCache)
        setupCharacterSignals(char)
        applyCharacterPhysics(char)
        if state.flying then
            resumeFlyState()
        end
    end)
    registerConnection("MainCharacterAddedSignal", mainCharacterAdded)

    if lp.Character then
        setupCharacterSignals(lp.Character)
        applyCharacterPhysics(lp.Character)
    end
