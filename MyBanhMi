    local function hookMultiJumpState(char)
        clearConnection("MultiJumpState")
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local conn = hum.StateChanged:Connect(function(_, newState)
                if newState == Enum.HumanoidStateType.Landed then
                    jumpCount = 0
                elseif newState == Enum.HumanoidStateType.Jumping then
                    jumpCount = jumpCount + 1
                end
            end)
            registerConnection("MultiJumpState", conn)
        else
            local conn = char.ChildAdded:Connect(function(child)
                if child:IsA("Humanoid") then
                    local stateConn = child.StateChanged:Connect(function(_, newState)
                        if newState == Enum.HumanoidStateType.Landed then
                            jumpCount = 0
                        elseif newState == Enum.HumanoidStateType.Jumping then
