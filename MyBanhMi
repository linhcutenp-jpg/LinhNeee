    -- ESP FUNCTIONS
    local function getESPColor(plr)
        if lp.Team and plr.Team then
            return (plr.Team == lp.Team) and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,50,50)
        end
        return Color3.fromRGB(255,170,0)
    end

    local function checkESPFilterValid(plr)
        if state.espFilter == "All" then return true
        elseif state.espFilter == "Enemy Only" then
            if lp.Team and plr.Team then
                return lp.Team ~= plr.Team
            end
            return true
        elseif state.espFilter == "Team Only" then
            if lp.Team and plr.Team then
                return lp.Team == plr.Team
            end
            return false
        end
        return true
    end

    local function createESPForPlayer(plr)
        if plr == lp or espData[plr] then return end
        if not checkESPFilterValid(plr) then return end

        local data = { connections = {}, retryConn = nil, lastDist = nil }
        espData[plr] = data

        local function setupCharEsp(char)
            if not state.esp or not char then return end
            
            if data.retryConn then
                pcall(function()
                    data.retryConn:Disconnect()
                end)
                data.retryConn = nil
            end

            local function trySetup()
                if not char.Parent then return false end
                local root = getRoot(char)
                if not root then return false end

                if (state.espMode == "Highlight" or state.espMode == "Both") and not data.highlight then
                    data.highlight = C("Highlight", {
                        OutlineColor = Color3.new(1,1,1),
                        FillColor = getESPColor(plr),
                        FillTransparency = Config.ESP_FILL_TRANSPARENCY,
                        Adornee = char
                    }, screen)
                end
                if (state.espMode == "Box" or state.espMode == "Both") and not data.box then
                    data.box = C("SelectionBox", {
                        Color3 = getESPColor(plr),
                        LineThickness = 0.04,
                        Transparency = 0.4,
                        Adornee = char
                    }, screen)
                end
                if not data.billboard then
                    data.billboard = C("BillboardGui", {
                        Size = UDim2.fromOffset(140,30),
                        StudsOffset = Vector3.new(0,3.5,0),
                        AlwaysOnTop = true,
                        Adornee = char:FindFirstChild("Head") or root
                    }, screen)
                    data.label = C("TextLabel", {
                        Parent = data.billboard,
                        Size = UDim2.fromScale(1,1),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextSize = 11,
                        TextStrokeTransparency = 0,
                        TextStrokeColor3 = Color3.new(0,0,0),
                        TextColor3 = getESPColor(plr),
                        Text = plr.Name
                    }, data.billboard)
                end
                return true
            end

            if not trySetup() then
                local retries = 0
                data.retryConn = RunService.Heartbeat:Connect(function()
                    retries = retries + 1
                    if trySetup() or retries >= 15 then
                        if data.retryConn then
                            data.retryConn:Disconnect()
                            data.retryConn = nil
                        end
                    end
                end)
                table.insert(data.connections, data.retryConn)
            end
        end

        if plr.Character then task.spawn(setupCharEsp, plr.Character) end
        table.insert(data.connections, plr.CharacterAdded:Connect(function(c)
            task.spawn(setupCharEsp, c)
        end))
    end

    local function removeESP(plr, clean)
        local d = espData[plr]
        if d then
            if d.highlight then pcall(function() d.highlight:Destroy() end) end
            if d.box then pcall(function() d.box:Destroy() end) end
            if d.billboard then pcall(function() d.billboard:Destroy() end) end
            if d.retryConn then pcall(function() d.retryConn:Disconnect() end) end
            if clean and d.connections then
                for _, c in ipairs(d.connections) do
                    pcall(function() c:Disconnect() end)
                end
            end
            espData[plr] = nil
        end
    end

    local updateAccum = 0

    local function requestEspUpdate(dt)
        updateAccum = updateAccum + dt
        if updateAccum < Config.ESP_UPDATE_INTERVAL then return end
        updateAccum = updateAccum - Config.ESP_UPDATE_INTERVAL

        if not state.esp then return end
        if not lp.Character then return end
        local myRoot = getRoot(lp.Character)
        if not myRoot then return end
        local myPos = myRoot.Position

        local enableHighlight = (state.espMode == "Highlight" or state.espMode == "Both")
        local enableBox = (state.espMode == "Box" or state.espMode == "Both")

        for plr, d in pairs(espData) do
            if not checkESPFilterValid(plr) then
                removeESP(plr, false)
            else
                local tRoot = getRoot(plr.Character)
                if not tRoot then
                    if d.billboard then d.billboard.Enabled = false end
                    if d.highlight then d.highlight.Enabled = false end
                    if d.box then d.box.Visible = false end
                    d.lastDist = nil
                else
                    local offset = tRoot.Position - myPos
                    local distSq = offset:Dot(offset)
                    local valid = distSq <= ESP_DIST_SQ

                    if d.billboard then d.billboard.Enabled = valid end
                    if d.highlight then d.highlight.Enabled = valid and enableHighlight end
                    if d.box then d.box.Visible = valid and enableBox end

                    if valid and d.label then
                        local roundedDist = math.floor(math.sqrt(distSq))

                        if d.lastDist ~= roundedDist then
                            d.label.Text = plr.Name .. " [" .. roundedDist .. "m]"
                            d.lastDist = roundedDist
                        end

                        local color = getESPColor(plr)
                        if d.label.TextColor3 ~= color then d.label.TextColor3 = color end

