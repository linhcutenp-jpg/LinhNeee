        if not part or part.Anchored then return false end
        pcall(function()
            part.CFrame = targetCF
            part.AssemblyLinearVelocity = Vector3.new(0,0,0)
            part.AssemblyAngularVelocity = Vector3.new(0,0,0)
        end)
        return true
    end

