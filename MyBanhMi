    local function periodicVerification()
        while state.scriptEnabled do
            task.wait(Config.SECURITY_HEARTBEAT)
            local allowed = false
            for _, id in ipairs(Config.ALLOWED_USER_IDS) do
                if id == lp.UserId then allowed = true end
            end
            if not allowed then
                warn("[Security] Unauthorized modification detected! Shutting down.")
                cleanupAll()
            end
        end
    end

