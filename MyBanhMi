    -- ==================== STATE ====================
    local state = {
        speedOn = false, speedValue = 100,
        jumpEnabled = false, jumpHeight = 100, infJump = false, multiJump = false,
        noclip = false, silentNoclip = false,
        esp = false, lootEsp = false, xray = false,
        flying = false, flySpeed = Config.FLY_DEFAULT_SPEED, flyMode = "Physics",
