    local lootBillboards = {}
    local screenGui = nil
    local LOOT_SCAN_INTERVAL = 1.0

    local function isLoot(inst)
        if not inst:IsA("BasePart") then return false end
        local name = string.lower(inst.Name)
        for _, kw in ipairs(Config.LOOT_KEYWORDS) do 
            if string.find(name, kw) then return true end 
        end
        return false
    end

    local function createLootBillboard(part)
        if not screenGui then return nil end
        local bb = C("BillboardGui", {Size=UDim2.fromOffset(110,25), StudsOffset=Vector3.new(0,2,0), AlwaysOnTop=true, Adornee=part}, screenGui)
        local label = C("TextLabel", {Parent=bb, Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Font=Enum.Font.GothamBold, TextSize=10, TextColor3=Color3.fromRGB(0,230,255)})
        return {bb = bb, label = label, lastDist = nil}
    end

    local function scanLootInRadius()
        local char = lp.Character
        if not state.lootEsp or not char or not screenGui then return end
        local root = getRoot(char)
        if not root then return end
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char}
        local parts = Workspace:GetPartBoundsInRadius(root.Position, Config.LOOT_SCAN_RADIUS, params)
        for _, p in ipairs(parts) do
            if isLoot(p) and not lootBillboards[p] then
                local data = createLootBillboard(p)
                if data then lootBillboards[p] = data end
            end
        end
        for part, data in pairs(lootBillboards) do
            if not part or not part.Parent then
                if data.bb then data.bb:Destroy() end
                lootBillboards[part] = nil
            end
        end
    end

    local function updateLootESP()
        local char = lp.Character
        if not state.lootEsp or not char or not screenGui then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local pos = root.Position
        local count = 0
        for part, data in pairs(lootBillboards) do
            if count >= Config.LOOT_MAX_RENDER then break end
            if part and part.Parent then
                local dist = (part.Position - pos).Magnitude
                if dist <= Config.LOOT_SCAN_RADIUS then
                    if data.label and data.lastDist ~= math.floor(dist) then
                        data.label.Text = "📦 " .. part.Name .. " [" .. math.floor(dist) .. "m]"
                        data.lastDist = math.floor(dist)
                    end
                    data.bb.Enabled = true
                    count = count + 1
                else
                    data.bb.Enabled = false
                end
            else
                if data.bb then data.bb:Destroy() end
                lootBillboards[part] = nil
            end
        end
    end

    task.spawn(function()
        while state.scriptEnabled do
            task.wait(LOOT_SCAN_INTERVAL)
            if state.lootEsp then
                pcall(scanLootInRadius)
                pcall(updateLootESP)
            end
        end
    end)

