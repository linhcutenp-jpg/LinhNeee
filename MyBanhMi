        end

        if state.freezeEnabled then
            local pOwner = getPartNetworkOwner and getPartNetworkOwner(selectedPart) or "Unknown"
            if pOwner == "Client (You)" or pOwner == "Server (Unassigned)" or pOwner == "Static" then
