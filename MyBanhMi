    local function updateLootESP()
        if not state.lootEspEnabled or not lp.Character then return end

        local root = lp.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local rootPos = root.Position
        local processedCount = 0
        local pendingRemoval = {}

        for part, cache in pairs(lootRegistry) do
            if not part or not part.Parent then
                table.insert(pendingRemoval, part)
            end
        end

        for _, part in ipairs(pendingRemoval) do
            removeLootFromRegistry(part)
        end

        for part, cache in pairs(lootRegistry) do
            if processedCount >= Config.LOOT_MAX_RENDER then break end

            local offset = part.Position - rootPos
            local distSq = offset:Dot(offset)

            if distSq <= LOOT_RADIUS_SQ then
                local dist = math.floor(math.sqrt(distSq))

                if cache.lastDist ~= dist then
                    cache.label.Text = "📦 " .. part.Name .. " [" .. dist .. "m]"
                    cache.lastDist = dist
                end

                cache.billboard.Enabled = true
                processedCount = processedCount + 1
            else
                cache.billboard.Enabled = false
            end
        end
    end

    local function clearLootEsp()
        for part, cache in pairs(lootRegistry) do
            if cache.billboard then pcall(function() cache.billboard:Destroy() end) end
        end
        table.clear(lootRegistry)
    end

