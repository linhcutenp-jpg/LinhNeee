    local function loadUIPreset()
        if isfile and isfile("LinhPremium_v10_7.json") then
            local success, data = pcall(function()
                return HttpService:JSONDecode(readfile("LinhPremium_v10_7.json"))
            end)
            if success and data then
                if data.theme then
                    currentThemeName = data.theme
                    win.BackgroundColor3 = Config.THEMES[data.theme].Primary
                    stroke.Color = Config.THEMES[data.theme].Accent
                end
                if data.speedValue then
                    state.speedValue = data.speedValue
                    if speedNum then speedNum.Text = tostring(state.speedValue) end
                end
                if data.jumpHeight then
                    state.jumpHeight = math.min(data.jumpHeight, Config.MAX_SAFE_JUMP_POWER)
                    if jumpValue then jumpValue.Text = tostring(state.jumpHeight) end
                end
                if data.espDistance then
                    Config.ESP_DISTANCE = data.espDistance
                    ESP_DIST_SQ = Config.ESP_DISTANCE * Config.ESP_DISTANCE
                    if distValue then distValue.Text = tostring(Config.ESP_DISTANCE) end
                end
                if data.xrayIntensity then
                    state.xrayIntensity = data.xrayIntensity
                    if xrayValue then xrayValue.Text = string.format("%.2f", state.xrayIntensity) end
                end
                if data.espMode then
                    state.espMode = data.espMode
                    if espModeBtn then espModeBtn.Text = "Mode: " .. state.espMode end
                end
                if data.espFilter then
                    state.espFilter = data.espFilter
                    if espFilterBtn then espFilterBtn.Text = "Filter: " .. state.espFilter end
                end
                if data.flyMethod then
                    state.flyMethod = data.flyMethod
                    if flyMethodBtn then flyMethodBtn.Text = "Engine: " .. state.flyMethod end
                end
                if data.flySpeed then
                    state.flySpeed = data.flySpeed
                    if flySpeedValue then flySpeedValue.Text = tostring(state.flySpeed) end
                end
            end
        end
    end

