    local function refreshFlyCaches()
        if not lp.Character then
            cachedHumanoid = nil
            cachedRoot = nil
            return
        end
        cachedHumanoid = lp.Character:FindFirstChildOfClass("Humanoid")
        cachedRoot = lp.Character:FindFirstChild("HumanoidRootPart")
