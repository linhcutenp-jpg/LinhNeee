    local physicsSandboxConn = RunService.Heartbeat:Connect(function()
        local now = time()
        if now - lastPhysicsUpdate < Config.PHYSICS_THROTTLE_FPS then return end
        lastPhysicsUpdate = now

        if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
        local root = lp.Character.HumanoidRootPart
        local currentPos = root.Position

        local shouldUpdate = false
        if lastPosition and (currentPos - lastPosition).Magnitude > 0.1 then
            shouldUpdate = true
        elseif now - lastForceUpdate > Config.FORCE_UPDATE_INTERVAL then
            shouldUpdate = true
            lastForceUpdate = now
        end

        if not shouldUpdate then return end
        lastPosition = currentPos

        if not selectedPart or not selectedPart.Parent or selectedPart.Anchored then return end

        if state.lockToMeEnabled then
            local pOwner = getPartNetworkOwner and getPartNetworkOwner(selectedPart) or "Unknown"
            if pOwner == "Client (You)" or pOwner == "Server (Unassigned)" or pOwner == "Static" then
                pcall(function()
                    selectedPart.CFrame = root.CFrame * CFrame.new(0, 1, -5)
                    selectedPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    selectedPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                end)
