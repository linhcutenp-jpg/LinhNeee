                end
            end)

            bringAllBtn.MouseButton1Click:Connect(function()
                if not selectedPart or selectedPart.Anchored then return end
                local name = selectedPart.Name
                local count = 0
                local targetCF = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,-5)
                if targetCF then
                    for _, p in pairs(Workspace:GetDescendants()) do
                        if p:IsA("BasePart") and p.Name == name and not p.Anchored and not isCharacterPart(p) then
                            networkBring(p, targetCF)
                            count = count + 1
                        end
                    end
                    if partInfoLabel then partInfoLabel.Text = string.format("🌀 Brought %d items!", count) end
                end
            end)

            toggleAnchoredBtn.MouseButton1Click:Connect(function()
                if not selectedPart or not selectedPart.Parent then
                    if partInfoLabel then partInfoLabel.Text = "⚠️ No part selected!" end
                    return
                end
                if originalAnchoredState == nil then originalAnchoredState = selectedPart.Anchored end
