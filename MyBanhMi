        local lastVel = Vector3.new(0,0,0)
        flyHeartbeatConn = RunService.RenderStepped:Connect(function()
            if not state.flying then 
                lastVel = Vector3.zero
                return 
            end
            local currentChar = lp.Character
            if not currentChar then return end
            if not cachedRoot or cachedRoot.Parent ~= currentChar then
                refreshFlyCaches()
                if not cachedRoot then return end
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local moveDir = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
            
            if moveDir.Magnitude > 0 then 
                lastVel = moveDir.Unit * math.min(state.flySpeed, Config.FLY_SPEED_MAX)
            else
                lastVel = Vector3.zero  -- FIX 8: Reset velocity khi thả phím
            end
            cachedRoot.AssemblyLinearVelocity = lastVel
        end)
        registerConnection("FlightEngineLoop", flyHeartbeatConn)
        return true
    end

    local function startFly()
        if state.flyMode == "Physics" then
            return startPhysicsFly()
        elseif state.flyMode == "CFrame" then
            return startCFrameFly()
        elseif state.flyMode == "Humanoid" then
            return startHumanoidFly()
        end
        return false
    end

    -- FIX 4: stopFly đúng thứ tự
    local function stopFly()
        if isResuming then return end
        pauseFlyState()
        state.flying = false
        
        clearConnection("FlightEngineLoop")
        clearConnection("CameraOrientationLoop")
        local char = lp.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then cleanupFlyComponents(root) end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum.PlatformStand = false
            end
        end
        flyLinearVel = nil
        flyAlignOri = nil
        flyAttach = nil
        cachedHumanoid = nil
        cachedRoot = nil
    end

    local function scheduleRebuildFly()
        if isRebuilding then return end
        isRebuilding = true
        local myToken = flyRebuildToken + 1
        flyRebuildToken = myToken
        local rebuildAttempts = 0
        local MAX_REBUILD_ATTEMPTS = 5

        local function attemptRebuild()
            if not state.flying then
                isRebuilding = false
                return
            end
            if myToken ~= flyRebuildToken then
                isRebuilding = false
                return
            end
            rebuildAttempts = rebuildAttempts + 1
            if rebuildAttempts > MAX_REBUILD_ATTEMPTS then
                warn("[Fly] Too many rebuild attempts, stopping")
                isRebuilding = false
                if state.flying then
                    stopFly()
                    state.flying = false
                end
                return
            end
            if resumeFailureCount >= MAX_RESUME_FAILURE then
                isRebuilding = false
                if state.flying then
                    stopFly()
                    state.flying = false
                end
                return
            end
            refreshFlyCaches()
            local char = lp.Character
            if char and cachedRoot and cachedRoot.Parent == char then
                local success = pcall(startFly)
                if success then
                    isRebuilding = false
                    rebuildRetryCount = 0
                    resumeFailureCount = 0
                else
                    resumeFailureCount = resumeFailureCount + 1
                    rebuildRetryCount = rebuildRetryCount + 1
                    if rebuildRetryCount < MAX_REBUILD_RETRY then
                        task.delay(0.5, attemptRebuild)
                    else
                        isRebuilding = false
                        if state.flying then
                            stopFly()
                            state.flying = false
                        end
                    end
                end
            elseif rebuildRetryCount < MAX_REBUILD_RETRY then
                rebuildRetryCount = rebuildRetryCount + 1
                task.delay(0.5, attemptRebuild)
            else
                isRebuilding = false
                if state.flying then
                    stopFly()
                    state.flying = false
                end
            end
        end

        task.defer(attemptRebuild)
    end

    local function toggleFly()
        if isResuming then return end
        state.flying = not state.flying
        if state.flying then
            local success = pcall(startFly)
            if not success then
                warn("[Fly] Failed to start, scheduling rebuild")
