    -- ========== APPLY CHARACTER PHYSICS ==========
    local function applyCharacterPhysics(char)
        if not char then return end
        if not lp.Character then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or not isHumanoidValid(hum) then return end
        if hum:GetState() == Enum.HumanoidStateType.Dead then return end

        hum.WalkSpeed = state.speedOn and state.speedValue or 16
        hum.UseJumpPower = true

        local targetJump = state.jumpEnabled and state.jumpHeight or 50
        hum.JumpPower = math.min(targetJump, Config.MAX_SAFE_JUMP_POWER)
    end

    -- ========== JUMP MODULE ==========
    local function detectJumpMethod(humanoid)
        return humanoid.UseJumpPower and "Power" or "Height"
    end

    local function enforceJumpValue(humanoid)
        if not state.jumpEnabled then return end
        if not humanoid or not isHumanoidValid(humanoid) then return end

        local now = time()
        if now - lastJumpReset < Config.JUMP_THROTTLE then return end
        lastJumpReset = now

        local targetValue = math.min(state.jumpHeight, Config.MAX_SAFE_JUMP_POWER)

        isInternalUpdate = true
        local success, err = pcall(function()
            if currentJumpMethod == "Height" then
                if humanoid.JumpHeight ~= targetValue then
                    humanoid.JumpHeight = targetValue
                    humanoid.UseJumpPower = false
                end
            else
                if humanoid.JumpPower ~= targetValue then
                    humanoid.JumpPower = targetValue
                    humanoid.UseJumpPower = true
                end
            end
        end)
        isInternalUpdate = false

        if not success then
            warn("[Jump] Enforce failed: " .. tostring(err))
        end
    end

    local function safeJumpHook()
        if not lp.Character then return false end

        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        local root = lp.Character:FindFirstChild("HumanoidRootPart")

        if not hum or not root then return false end
        if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
        if hum:GetState() == Enum.HumanoidStateType.Jumping then return false end

        hum:ChangeState(Enum.HumanoidStateType.Jumping)

        if currentJumpMethod == "Height" then
            pcall(function()
                local currentVel = root.AssemblyLinearVelocity
                local jumpVel = math.min(state.jumpHeight, Config.MAX_SAFE_JUMP_POWER) / 2.5
                root.AssemblyLinearVelocity = Vector3.new(currentVel.X, jumpVel, currentVel.Z)
            end)
        end

        return true
    end

    local function setupJumpPatch(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        currentHumanoid = humanoid
        currentJumpMethod = detectJumpMethod(humanoid)

        local propertyName = (currentJumpMethod == "Height") and "JumpHeight" or "JumpPower"

        clearConnection("JumpPropertyListener")

        local propertyConn = humanoid:GetPropertyChangedSignal(propertyName):Connect(function()
            if isInternalUpdate then return end
            if not state.jumpEnabled then return end

            local currentValue = (currentJumpMethod == "Height") and humanoid.JumpHeight or humanoid.JumpPower
            local targetValue = math.min(state.jumpHeight, Config.MAX_SAFE_JUMP_POWER)

            if currentValue ~= targetValue then
                enforceJumpValue(humanoid)
            end
        end)
        registerConnection("JumpPropertyListener", propertyConn)

        task.defer(function()
            if humanoid and isHumanoidValid(humanoid) then
                enforceJumpValue(humanoid)
            end
        end)
    end

    local function onCharacterAdded(character)
