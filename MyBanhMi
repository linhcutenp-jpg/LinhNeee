    -- ==================== PHYSICS SANDBOX ====================
    local lastPhysicsTime = 0
    local lastPos = nil
    local lastForceUpdate = 0

    local function updatePhysicsSandbox()
        if os.time() - lastPhysicsTime < 0.03 then return end
        lastPhysicsTime = os.time()
        local char = lp.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local currentPos = root.Position
        local shouldUpdate = false
        if lastPos and (currentPos - lastPos).Magnitude > 0.1 then 
            shouldUpdate = true
        elseif os.time() - lastForceUpdate > 2 then 
            shouldUpdate = true
            lastForceUpdate = os.time() 
        end
        if not shouldUpdate then return end
        lastPos = currentPos
        if not selectedPart or not selectedPart.Parent or selectedPart.Anchored then return end
        if state.lockToMeEnabled then
            local pOwner = getPartNetworkOwner(selectedPart)
            if pOwner == "Client (You)" or pOwner == "Server" or pOwner == "Static" then
                pcall(function()
                    selectedPart.CFrame = root.CFrame * CFrame.new(0, 1, -5)
                    selectedPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    selectedPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                end)
            end
        end
        if state.freezeEnabled then
            local pOwner = getPartNetworkOwner(selectedPart)
            if pOwner == "Client (You)" or pOwner == "Server" or pOwner == "Static" then
                pcall(function()
                    selectedPart.AssemblyLinearVelocity = Vector3.new(0, 0.08, 0)
