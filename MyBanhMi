    local function ensureFlyComponents(root)
        if not root then return false end
        local valid = flyAttachment and flyAttachment.Parent == root and
                      flyLinearVelocity and flyLinearVelocity.Parent == root and
                      flyAlignOrientation and flyAlignOrientation.Parent == root
        if valid then return true end
        
        local oldAtt, oldLV, oldAO = flyAttachment, flyLinearVelocity, flyAlignOrientation
        
        flyAttachment = Instance.new("Attachment")
        flyAttachment.Name = "LinhFlyAttachment"
        
        flyLinearVelocity = Instance.new("LinearVelocity")
        flyLinearVelocity.Name = "LinhFlyLinearVelocity"
        flyLinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        flyLinearVelocity.VectorVelocity = Vector3.new(0,0,0)
        flyLinearVelocity.Attachment0 = flyAttachment
        flyLinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
        
        flyAlignOrientation = Instance.new("AlignOrientation")
        flyAlignOrientation.Name = "LinhFlyAlignOrientation"
        flyAlignOrientation.RigidityEnabled = true
        flyAlignOrientation.Responsiveness = 55
        flyAlignOrientation.Attachment0 = flyAttachment
        
        flyAttachment.Parent = root
        flyLinearVelocity.Parent = root
        flyAlignOrientation.Parent = root
        
        if oldAtt then pcall(function() oldAtt:Destroy() end) end
        if oldLV then pcall(function() oldLV:Destroy() end) end
        if oldAO then pcall(function() oldAO:Destroy() end) end
        return true
    end

    local function pauseFlyState()
        pcall(function()
            if flyLinearVelocity then flyLinearVelocity.VectorVelocity = Vector3.new(0,0,0) end
            setOrientationEnabledFly(false)
            if flyConn then flyConn:Disconnect(); flyConn = nil end
            if cameraConn then cameraConn:Disconnect(); cameraConn = nil end
        end)
        clearConnection("FlightEngineLoop")
        clearConnection("CameraOrientationLoop")
    end

    local function resumeFlyState()
        if not state.flying or not lp.Character then return false end
        
        local ok = pcall(function()
            refreshFlyCaches()
            if not cachedHumanoid or not cachedRoot then error("No humanoid/root") end
            if not ensureFlyComponents(cachedRoot) then error("Failed components") end
            setOrientationEnabledFly(true)
            
            if flyConn then flyConn:Disconnect() end
            if cameraConn then cameraConn:Disconnect() end
            
            flyConn = RunService.Heartbeat:Connect(function()
                if not state.flying or not lp.Character then
                    pauseFlyState()
                    return
                end
                if not cachedRoot or cachedRoot.Parent ~= lp.Character then
                    refreshFlyCaches()
                    if not cachedRoot then pauseFlyState(); return end
                end
                if flyAttachment and flyAttachment.Parent ~= cachedRoot then
                    ensureFlyComponents(cachedRoot)
                end
                
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local camCF = cam.CFrame
                local moveDir = Vector3.new(0,0,0)
                
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCF.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCF.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
                
                if moveDir.Magnitude > 0 then
                    moveDir = moveDir.Unit * state.flySpeed
                end
                
                if flyLinearVelocity then
                    flyLinearVelocity.VectorVelocity = moveDir
                end
            end)
            
            cameraConn = RunService.RenderStepped:Connect(function()
                if not state.flying or not lp.Character then return end
                if flyAlignOrientation and flyAlignOrientation.Parent then
                    flyAlignOrientation.CFrame = getCameraRotationFly()
                end
            end)
            
            registerConnection("FlightEngineLoop", flyConn)
            registerConnection("CameraOrientationLoop", cameraConn)
        end)
        return ok
    end

    local function stopFly()
        state.flying = false
